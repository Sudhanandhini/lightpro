# Lightpro Technologies - static frontend (Vite build), served from /lightpro on cPanel.
# Upload the contents of dist/ into public_html/lightpro/ (this file included).
#
# Every page is pre-rendered to its own HTML file (about.html, contact.html, ...),
# so /lightpro/about is served from about.html with a 200 and full content for crawlers.

DirectoryIndex index.html
# /digital-workspace-solutions is both a page and a folder; don't redirect it to a trailing slash
DirectorySlash Off
ErrorDocument 404 /lightpro/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /lightpro/

  # Force HTTPS so Google sees one copy of each page
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Drop .html and trailing slashes from addresses: /about.html and /about/ -> /about
  RewriteCond %{THE_REQUEST} \s/+lightpro/(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # /about -> about.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache hashed build assets aggressively; always revalidate HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml|og-image\.jpg|favicon\.svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

Options -Indexes
